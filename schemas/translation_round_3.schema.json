{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["round", "status", "artifact", "quote_count", "rows"],
  "properties": {
    "round": {"const": 3}, "status": {"const": "completed"},
    "artifact": {"type": "string", "minLength": 1},
    "quote_count": {"type": "integer", "minimum": 1},
    "rows": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["quote_id", "source_en", "current_cn", "evidence_basis", "claims", "adjudication", "changed"],
      "properties": {
        "quote_id": {"type": "string", "minLength": 1},
        "source_en": {"type": "string", "minLength": 1},
        "current_cn": {"type": "string", "minLength": 1},
        "evidence_basis": {"type": "array", "minItems": 3, "uniqueItems": true,
          "contains": {"const": "round0_asr"}},
        "claims": {"type": "object", "additionalProperties": false,
          "required": ["subject", "negation", "quantity", "modality", "scope", "terms", "causality", "source_time"],
          "properties": {
            "subject": {"type": "string", "minLength": 1}, "negation": {"type": "string", "minLength": 1},
            "quantity": {"type": "string", "minLength": 1}, "modality": {"type": "string", "minLength": 1},
            "scope": {"type": "string", "minLength": 1}, "terms": {"type": "array"},
            "causality": {"type": "string", "minLength": 1}, "source_time": {"type": "number", "minimum": 0}
          }
        },
        "adjudication": {"enum": ["retain", "revise", "stop"]},
        "changed": {"type": "boolean"}
      }
    }}
  }
}
