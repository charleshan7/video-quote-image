{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "required": ["people"],
  "properties": {"people": {"type": "array", "minItems": 1, "items": {
    "type": "object",
    "required": ["person_id", "name", "person_type", "role", "source_url", "source_quote", "verified_at", "confidence"],
    "properties": {
      "person_id": {"type": "string", "minLength": 1},
      "name": {"type": "string", "minLength": 1},
      "person_type": {"enum": ["interviewer", "interviewee", "speaker", "narrator", "subject"]},
      "role": {"type": "string", "minLength": 1},
      "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
      "source_quote": {"type": "string", "minLength": 1},
      "verified_at": {"type": "string", "format": "date-time"},
      "confidence": {"type": "number", "minimum": 0, "maximum": 1}
    }
  }}}
}
