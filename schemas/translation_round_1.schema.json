{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["round", "status", "artifact", "quote_count", "rows"],
  "properties": {
    "round": {"const": 1}, "status": {"const": "completed"},
    "artifact": {"type": "string", "minLength": 1},
    "quote_count": {"type": "integer", "minimum": 1},
    "rows": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["quote_id", "source_en", "current_cn", "checks", "adjudication", "changed"],
      "properties": {
        "quote_id": {"type": "string", "minLength": 1},
        "source_en": {"type": "string", "minLength": 1},
        "current_cn": {"type": "string", "minLength": 1},
        "checks": {"type": "object", "additionalProperties": false,
          "required": ["subject", "person", "negation", "quantity", "scope", "causality", "tone", "terms"],
          "properties": {
            "subject": {"enum": ["pass", "revise"]}, "person": {"enum": ["pass", "revise"]},
            "negation": {"enum": ["pass", "revise"]}, "quantity": {"enum": ["pass", "revise"]},
            "scope": {"enum": ["pass", "revise"]}, "causality": {"enum": ["pass", "revise"]},
            "tone": {"enum": ["pass", "revise"]}, "terms": {"enum": ["pass", "revise"]}
          }
        },
        "adjudication": {"enum": ["retain", "revise", "stop"]},
        "changed": {"type": "boolean"}
      }
    }}
  }
}
