{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "required": ["status", "risk_flags", "rows"],
  "properties": {
    "status": {"const": "completed"},
    "risk_flags": {"type": "array", "minItems": 1, "uniqueItems": true},
    "rows": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["quote_id", "risk_tags", "source_en", "current_cn", "challenge", "evidence", "decision", "revision", "reviewer", "reviewed_at"],
      "properties": {
        "quote_id": {"type": "string", "minLength": 1},
        "risk_tags": {"type": "array", "minItems": 1, "uniqueItems": true},
        "source_en": {"type": "string", "minLength": 1},
        "current_cn": {"type": "string", "minLength": 1},
        "challenge": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true},
        "decision": {"enum": ["retain", "revise", "stop"]},
        "revision": {"type": "string"},
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    }}
  }
}
