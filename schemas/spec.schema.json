{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "required": ["images"],
  "properties": {
    "meta": {"type": "object"},
    "images": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "title", "hero_time", "quotes"],
      "properties": {
        "id": {"type": ["string", "integer"]}, "title": {"type": "string", "minLength": 1}, "hero_time": {"type": "number", "minimum": 0},
        "quotes": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["quote_id", "time", "match", "source_en", "en", "cn"],
          "properties": {"quote_id": {"type": ["string", "integer"]}, "time": {"type": "number", "minimum": 0}, "frame_time": {"type": "number", "minimum": 0}, "match": {"type": "string", "minLength": 1}, "source_en": {"type": "string", "minLength": 1}, "en": {"type": "string"}, "cn": {"type": "string"}}
        }}
      }
    }}
  }
}
