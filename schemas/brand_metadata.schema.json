{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "source", "output", "source_sha256", "output_sha256", "icon_sha256",
    "wordmark_sha256", "latin_font", "latin_font_sha256", "render_metadata",
    "render_sha256", "icon_box", "wordmark_box", "parameters"
  ],
  "properties": {
    "source": {"type": "string", "minLength": 1},
    "output": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "icon_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "wordmark_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "latin_font": {"type": "string", "minLength": 1},
    "latin_font_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "render_metadata": {"type": "string", "minLength": 1},
    "render_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "icon_box": {"type": "array", "minItems": 4, "maxItems": 4},
    "wordmark_box": {"type": "array", "minItems": 4, "maxItems": 4},
    "parameters": {"type": "object", "minProperties": 1}
  }
}
